# GEMINI_API_KEY: Required for Gemini AI API calls (news, trivia, quiz report).
# Read only by the API server (server/index.ts). Never exposed to the browser.
GEMINI_API_KEY="your_api_key_here"

# GEMINI_MODEL: Optional. Gemini model ID used by the API server (default: gemini-3.6-flash).
# Models are retired over time; check with `npm run check:gemini` after changing it.
GEMINI_MODEL=""

# TRUST_PROXY: Optional. Set when the API server runs behind a reverse proxy,
# so rate limits are counted per client IP instead of per proxy.
# "1" = trust one proxy hop (e.g. Cloud Run), "loopback" = local nginx. Leave empty when exposed directly.
TRUST_PROXY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TRIVIA_API_PORT: Optional port for local trivia assignment API server.
TRIVIA_API_PORT="8787"

# VITE_DEBUG_MODE: Enable debug features like trivia refresh button.
VITE_DEBUG_MODE="false"
